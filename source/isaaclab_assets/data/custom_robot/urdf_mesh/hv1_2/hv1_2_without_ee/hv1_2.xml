<mujoco model="HV1_2_Without_Arms">
  <compiler angle="radian"/>

  <!-- Match Isaac sim_dt = 0.005 (200 Hz physics, policy at 50 Hz with decimation=4). -->
  <option timestep="0.005" iterations="50" tolerance="1e-10" integrator="Euler"/>

  <!-- Joint physics per actuator group (values from HV1_2_CFG in unitree.py).
       NOTE on damping: this is the *passive viscous friction* component only.
       Isaac's `ImplicitActuatorCfg.damping` (Kd) is the *active controller*
       gain — that lives in the Python PD loop, not here. Splitting prevents
       double-counting damping in MuJoCo.
       Geom defaults scope robot self-collision off (contype=1, conaffinity=0)
       so the floor (default contype/conaffinity = 1/1) still collides with the
       robot but robot geoms don't collide with each other. -->
  <default>
    <default class="hv1_2">
      <geom contype="1" conaffinity="0"/>
      <default class="legs_x12_320">
        <joint armature="0.326938" frictionloss="1.694307" damping="0.350134"/>
      </default>
      <default class="ankles_x8_120">
        <joint armature="0.065893" frictionloss="0.849291" damping="0.379237"/>
      </default>
      <default class="wristroll_x6_60">
        <joint armature="0.019603" frictionloss="0.321816" damping="0.165640"/>
      </default>
      <default class="waist_shoulder_elbow_x8_120">
        <joint armature="0.065893" frictionloss="0.849291" damping="0.379237"/>
      </default>
      <default class="wrist_head_x4_36">
