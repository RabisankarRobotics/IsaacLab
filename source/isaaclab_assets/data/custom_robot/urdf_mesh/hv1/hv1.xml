<mujoco model="HV1">
  <compiler angle="radian"/>

  <option timestep="0.005" iterations="50" solver="Newton" gravity="0 0 -9.81"/>

  <!--
    Joint physics defaults — these MUST match the Isaac actuator config in
    source/isaaclab_assets/isaaclab_assets/robots/unitree.py (HV1_CFG), otherwise
    the policy sees totally different dynamics in MuJoCo than it saw during
    training. Mapping (Isaac → MJCF):
      damping        ← viscous_friction  (Nm·s/rad, scales with joint velocity)
      frictionloss   ← friction          (Nm, Coulomb / static friction)
      armature       ← armature          (kg·m², rotor inertia at joint)
      stiffness/Kd   ← NOT set on joint — applied by deploy script as PD law.

    Geom self-collision: Isaac trains with self_collision=False, so the policy
    has no learned avoidance of arm-on-torso etc. To match, we use a SCOPED
    geom class "robot" (contype=1, conaffinity=0) applied via childclass on the
    pelvis body — this leaves scene.xml's floor at MuJoCo's default
    (contype=1, conaffinity=1), so foot-vs-floor still collides while robot
    body geoms ignore each other.
  -->
  <default>
    <!-- Legs class: hip_*, knee, waist_* (Isaac "legs" actuator: 85 Nm, X12-320) -->
    <default class="legs_joint">
      <joint damping="0.350134" armature="0.326938" frictionloss="1.694307"/>
    </default>
    <!-- Ankle/wrist-roll class: X6-60, 20 Nm -->
    <default class="ankle_wristroll_joint">
      <joint damping="0.165640" armature="0.019603" frictionloss="0.321816"/>
    </default>
    <!-- Shoulder/elbow class: X8-120, 43 Nm -->
    <default class="shoulder_elbow_joint">
      <joint damping="0.379237" armature="0.065893" frictionloss="0.849291"/>
    </default>
    <!-- Wrist-pitch/yaw + neck class: X4-36, 10.5 Nm -->
    <default class="wrist_neck_joint">
      <joint damping="0.154954" armature="0.045213" frictionloss="0.388995"/>
    </default>
    <!-- Robot-body geom class — scoped via childclass on pelvis so the world
         floor in scene.xml stays at MuJoCo's default contype=1, conaffinity=1. -->
    <default class="robot">
      <geom contype="1" conaffinity="0"/>
    </default>
  </default>

